{
  "name": "alibi-monorepo",
  "version": "1.0.0",
  "description": "Alibi Game - Monorepo with Vercel-compatible frontend and WebSocket server",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:server": "cd apps/server && npm run dev",
    "start:server": "cd apps/server && npm start"
  },
  "keywords": ["websocket", "game", "interrogation", "node.js", "monorepo", "vercel"],
  "author": "",
  "license": "MIT"
}
