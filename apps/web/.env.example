# WebSocket Server URL for Production
# Copy this file to .env and update with your actual WebSocket server URL

# Development (local)
# WS_URL=ws://localhost:3000

# Production (update with your deployed WebSocket server)
# WS_URL=wss://your-alibi-server.railway.app
# or
# WS_URL=wss://your-alibi-server.onrender.com
